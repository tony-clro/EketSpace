# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps API Key for interactive market locator and mapping
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAP_API_KEY"

# Paystack API Keys (Nigerian Naira NGN test/live)
PAYSTACK_SECRET_KEY="sk_test_placeholder_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_placeholder_key"
